{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "outDir": "dist"
  },
  "include": [
    "src/**/*",
    "../lib/**/*",
    "../constants/**/*",
    "../utils/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
