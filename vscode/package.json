{
  "name": "adbsnap",
  "displayName": "ADBSnap — Mobile Screenshot & Asset Studio",
  "description": "Capture Android and iOS screenshots, create 4K device mockups, and export App Store / Google Play assets in VS Code.",
  "version": "1.3.0",
  "publisher": "shriramsingh",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shriramsingh/adbsnap"
  },
  "homepage": "https://github.com/shriramsingh/adbsnap#readme",
  "categories": [
    "Other",
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "adbsnap",
    "adb",
    "android",
    "ios",
    "ios simulator",
    "iphone",
    "ipad",
    "xcode",
    "screenshot",
    "mobile screenshot",
    "mockup",
    "device frame",
    "app store",
    "google play",
    "pixel",
    "iphone",
    "flutter",
    "react native"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "adbsnap.snap",
        "title": "ADBSnap: Quick Capture (Framed)",
        "icon": "$(camera)"
      },
      {
        "command": "adbsnap.snapClipboard",
        "title": "ADBSnap: Capture & Copy to Clipboard",
        "icon": "$(copy)"
      },
      {
        "command": "adbsnap.snapRaw",
        "title": "ADBSnap: Capture Raw Screenshot",
        "icon": "$(device-mobile)"
      },
      {
        "command": "adbsnap.devices",
        "title": "ADBSnap: Select Active Device",
        "icon": "$(refresh)"
      },
      {
        "command": "adbsnap.wifi",
        "title": "ADBSnap: Switch to Wireless ADB (WiFi)",
        "icon": "$(radio-tower)"
      },
      {
        "command": "adbsnap.disconnectWifi",
        "title": "Turn Off Wi-Fi Mode (Revert to USB)",
        "icon": "$(plug)"
      },
      {
        "command": "adbsnap.doctor",
        "title": "ADBSnap: Run ADB Doctor Diagnostics",
        "icon": "$(pulse)"
      },
      {
        "command": "adbsnap.export",
        "title": "ADBSnap: Export Store Asset Pack (ZIP)",
        "icon": "$(archive)"
      },
      {
        "command": "adbsnap.openStudio",
        "title": "ADBSnap: Open Asset Studio",
        "icon": "$(paintcan)"
      },
      {
        "command": "adbsnap.refreshDevices",
        "title": "Refresh Connected Devices",
        "icon": "$(refresh)"
      },
      {
        "command": "adbsnap.refreshCaptures",
        "title": "Refresh Captures",
        "icon": "$(refresh)"
      },
      {
        "command": "adbsnap.snapDeviceFromTree",
        "title": "Capture Framed Screenshot",
        "icon": "$(camera)"
      },
      {
        "command": "adbsnap.revealCapture",
        "title": "Reveal in File Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "adbsnap.copyCapture",
        "title": "Copy Image to Clipboard",
        "icon": "$(copy)"
      },
      {
        "command": "adbsnap.connectIp",
        "title": "ADBSnap: Connect Device via Wi-Fi IP",
        "icon": "$(broadcast)"
      },
      {
        "command": "adbsnap.pairWifi",
        "title": "ADBSnap: Pair Wireless Device (Android 11+ Code)",
        "icon": "$(key)"
      },
      {
        "command": "adbsnap.reconnectDevice",
        "title": "Reconnect Wireless Device",
        "icon": "$(sync)"
      },
      {
        "command": "adbsnap.deleteCapture",
        "title": "Delete Screenshot",
        "icon": "$(trash)"
      },
      {
        "command": "adbsnap.openCaptureInStudio",
        "title": "Open in Asset Studio",
        "icon": "$(paintcan)"
      },
      {
        "command": "adbsnap.insertMarkdown",
        "title": "ADBSnap: Capture and Insert into Document",
        "icon": "$(markdown)"
      },
      {
        "command": "adbsnap.selectFrame",
        "title": "ADBSnap: Change Default Bezel Frame",
        "icon": "$(device-mobile)"
      },
      {
        "command": "adbsnap.selectTheme",
        "title": "ADBSnap: Change Default Canvas Theme",
        "icon": "$(color-mode)"
      },
      {
        "command": "adbsnap.selectFormat",
        "title": "ADBSnap: Change Default Export Format",
        "icon": "$(file-media)"
      },
      {
        "command": "adbsnap.explore",
        "title": "ADBSnap: Explore & Capture Android App Tabs",
        "icon": "$(compass)"
      },
      {
        "command": "adbsnap.exploreIos",
        "title": "ADBSnap: Explore & Capture iOS App Views (XCTest)",
        "icon": "$(compass)"
      },
      {
        "command": "adbsnap.resetAppData",
        "title": "ADBSnap: Reset App Data (Logout / Clear Cache)",
        "icon": "$(clear-all)"
      },
      {
        "command": "adbsnap.relaunchApp",
        "title": "ADBSnap: Relaunch Mobile App",
        "icon": "$(debug-restart)"
      }
    ],
    "keybindings": [
      {
        "command": "adbsnap.snap",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "adbsnap.snapClipboard",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "configuration": {
      "title": "ADBSnap",
      "properties": {
        "adbsnap.defaultTheme": {
          "type": "string",
          "default": "aurora",
          "enum": [
            "aurora",
            "studioLight",
            "freshMint",
            "sunset",
            "midnight",
            "royal",
            "cleanDark",
            "fintech",
            "lavender",
            "cyberpunk",
            "crimsonVoid",
            "cobalt",
            "terracotta",
            "slateCarbon",
            "pureWhite",
            "none"
          ],
          "description": "Default canvas gradient backdrop preset"
        },
        "adbsnap.defaultFrame": {
          "type": "string",
          "default": "iphone-16-pro",
          "enum": [
            "iphone-16-pro-max",
            "iphone-16-pro",
            "iphone-16",
            "iphone-15-pro",
            "iphone-14",
            "pixel-9-pro-fold",
            "pixel-9-pro",
            "pixel-8",
            "galaxy-s25-ultra",
            "galaxy-s24-ultra",
            "galaxy-s24",
            "ipad-pro-13",
            "android-tablet-10",
            "minimal",
            "none"
          ],
          "description": "Default device bezel chassis"
        },
        "adbsnap.defaultFormat": {
          "type": "string",
          "default": "png",
          "enum": [
            "png",
            "webp",
            "avif",
            "jpeg"
          ],
          "description": "Default screenshot and export image format"
        },
        "adbsnap.outputDirectory": {
          "type": "string",
          "default": "${workspaceFolder}/output",
          "description": "Directory where captured screenshots and assets will be saved"
        },
        "adbsnap.customAdbPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to adb binary (leave blank for automatic detection)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adbsnap-sidebar",
          "title": "ADBSnap",
          "icon": "assets/sidebar.svg"
        }
      ]
    },
    "views": {
      "adbsnap-sidebar": [
        {
          "id": "adbsnap.devicesView",
          "name": "Connected Devices"
        },
        {
          "id": "adbsnap.recentCapturesView",
          "name": "Recent Captures"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "adbsnap.insertMarkdown",
          "when": "editorTextFocus",
          "group": "modification@10"
        }
      ],
      "view/title": [
        {
          "command": "adbsnap.openStudio",
          "when": "view == adbsnap.devicesView",
          "group": "navigation"
        },
        {
          "command": "adbsnap.connectIp",
          "when": "view == adbsnap.devicesView",
          "group": "navigation@2"
        },
        {
          "command": "adbsnap.explore",
          "when": "view == adbsnap.devicesView",
          "group": "navigation@3"
        },
        {
          "command": "adbsnap.refreshDevices",
          "when": "view == adbsnap.devicesView",
          "group": "navigation@4"
        },
        {
          "command": "adbsnap.refreshCaptures",
          "when": "view == adbsnap.recentCapturesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "adbsnap.reconnectDevice",
          "when": "view == adbsnap.devicesView && viewItem == device-wifi-offline",
          "group": "inline"
        },
        {
          "command": "adbsnap.snapDeviceFromTree",
          "when": "view == adbsnap.devicesView && viewItem =~ /^device-(ready|active|wifi)/",
          "group": "inline"
        },
        {
          "command": "adbsnap.reconnectDevice",
          "when": "view == adbsnap.devicesView && viewItem =~ /^device-wifi/",
          "group": "inline"
        },
        {
          "command": "adbsnap.disconnectWifi",
          "when": "view == adbsnap.devicesView && viewItem =~ /^device-wifi/",
          "group": "inline"
        },
        {
          "command": "adbsnap.openCaptureInStudio",
          "when": "view == adbsnap.recentCapturesView && viewItem == capture-image",
          "group": "inline"
        },
        {
          "command": "adbsnap.copyCapture",
          "when": "view == adbsnap.recentCapturesView && viewItem == capture-image",
          "group": "inline"
        },
        {
          "command": "adbsnap.revealCapture",
          "when": "view == adbsnap.recentCapturesView",
          "group": "inline"
        },
        {
          "command": "adbsnap.deleteCapture",
          "when": "view == adbsnap.recentCapturesView",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "release:patch": "npm version patch && node esbuild.mjs && npx @vscode/vsce package --no-dependencies",
    "release:minor": "npm version minor && node esbuild.mjs && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0"
  }
}
