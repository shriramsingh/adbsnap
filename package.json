{
  "name": "adbsnap",
  "version": "1.3.0",
  "description": "Capture Android and iOS simulator/device screenshots, create 4K mockups, explore iOS apps with XCTest, and export store assets (CLI & VS Code)",
  "main": "dist/bin/cli.js",
  "bin": {
    "adbsnap": "dist/bin/cli.js",
    "snapshot": "dist/bin/cli.js"
  },
  "author": "Shriram Singh",
  "license": "MIT",
  "keywords": [
    "adbsnap",
    "adb",
    "android",
    "ios",
    "ios-simulator",
    "iphone",
    "ipad",
    "xctest",
    "xcuitest",
    "screenshot",
    "adb-screenshot",
    "android-screenshot",
    "mockup",
    "device-mockup",
    "device-frames",
    "appstore",
    "google-play",
    "app-store-screenshots",
    "play-store-screenshots",
    "frameless-mockup",
    "mobile-showcase",
    "sharp",
    "developer-tools",
    "vscode",
    "cli"
  ],
  "files": [
    "dist/bin",
    "dist/studio",
    "dist/ios",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "version:sync": "node scripts/bump-version.mjs",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "build:cli": "node scripts/build-cli.mjs",
    "build": "node scripts/build-cli.mjs",
    "snap": "tsx bin/cli.ts snap",
    "export": "tsx bin/cli.ts export",
    "devices": "tsx bin/cli.ts devices",
    "doctor": "tsx bin/cli.ts doctor",
    "explore:ios": "tsx bin/cli.ts explore-ios",
    "wifi": "tsx bin/cli.ts wifi",
    "usb": "tsx bin/cli.ts usb",
    "explore": "tsx bin/cli.ts explore",
    "crawl": "tsx bin/cli.ts crawl",
    "journey": "tsx bin/cli.ts journey",
    "run": "tsx bin/cli.ts run",
    "test:devices": "tsx scripts/test-devices.ts",
    "test:capture": "tsx scripts/test-capture.ts",
    "test:composite": "tsx scripts/test-composite.ts",
    "test:ios": "tsx scripts/test-ios-simulator.ts",
    "test:ios:simulator": "tsx scripts/test-ios-simulator.ts",
    "test:ios-driver": "tsx scripts/test-ios-driver.ts",
    "test:ios:explorer": "tsx scripts/explore-ios.ts",
    "test:ios:ci": "npm run test:ios-driver && npm run test:ios:explorer && npm run test:ios:simulator && npm run build && npm run build:vscode",
    "test:lifecycle": "tsx scripts/test-lifecycle.ts",
    "test:wifi": "tsx scripts/test-wifi.ts",
    "studio": "tsx bin/cli.ts studio",
    "build:vscode": "node vscode/esbuild.mjs",
    "watch:vscode": "node vscode/esbuild.mjs --watch",
    "package:vscode": "cd vscode && npx @vscode/vsce package --no-dependencies"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shriramsingh/adbsnap.git"
  },
  "homepage": "https://shriramsingh.github.io/adbsnap/",
  "bugs": {
    "url": "https://github.com/shriramsingh/adbsnap/issues"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.138.0",
    "autoprefixer": "^10.5.5",
    "chalk": "^6.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.42.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.4"
  }
}
